# Pinned components. Compose reads this file through --env-file and
# interpolates every image tag from it; the image names live in compose.yaml
# and the Dockerfiles. Experiments with other pins are a branch.
# The llama.cpp server image tag names the exact build (the b-number suffix).
# Each base image is pinned by its tag and by the sha256 of its manifest
# list, because a tag can be moved; the digest is what the build pulls.
LLAMA_CPP_TAG=server-cuda13-b11028
LLAMA_CPP_DIGEST=4dd12366f8219cc77e608fce27b8efcaa44c581692ecacfb957c4429741b7306
PI_VERSION=0.85.1
OMP_VERSION=18.2.5
NODE_TAG=26.9.0-bookworm-slim
NODE_DIGEST=582460f614631b59b824ac6020533b9bf339c7fdf3a6d7db31abb6b4065f0212
BUN_TAG=1.4.2-slim
BUN_DIGEST=cb3bbbb08e13a4a2ff400f24c7a2a1d5efa83f6ef8544d52d95a519631e2fc61
# The dashboard profile's images (LLM_DASHBOARD=true), pinned the same way.
VICTORIAMETRICS_TAG=v1.152.0
VICTORIAMETRICS_DIGEST=86ca5fdb6d87d56ba047b044039019ba2bd9042b36e35f6ea34e437b6c825cef
GRAFANA_TAG=13.2.2
GRAFANA_DIGEST=ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0
# NVIDIA's GPU exporter for the dashboard (nvcr.io; `pins check` does not
# resolve it, the tag pairs a DCGM version with the exporter's).
DCGM_EXPORTER_TAG=4.6.1-4.8.4
DCGM_EXPORTER_DIGEST=148b0c025e5f2850256816fa33754fbf4733b7a086697a95613fc0ba3db5b003
CUDA_MIN_DRIVER_MAJOR=580
