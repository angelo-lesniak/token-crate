# Pinned components. Compose reads this file through --env-file and
# interpolates every image tag from it; the image names live in compose.yaml
# and the Dockerfiles. Experiments with other pins are a branch.
# The llama.cpp server image tag names the exact build (the b-number suffix).
# Each base image is pinned by its tag and by the sha256 of its manifest
# list, because a tag can be moved; the digest is what the build pulls.
LLAMA_CPP_TAG=server-cuda13-b12182
LLAMA_CPP_DIGEST=38ab331a06df01e2c8a024e3c81dc66842b07d7cc015703bf2d648ea0d49e52c
PI_VERSION=1.5.0
OMP_VERSION=18.18.0
NODE_TAG=26.13.0-trixie-slim
NODE_DIGEST=5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072
BUN_TAG=1.4.4-slim
BUN_DIGEST=1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4
# The dashboard profile's images (LLM_DASHBOARD=true), pinned the same way.
VICTORIAMETRICS_TAG=v1.155.0
VICTORIAMETRICS_DIGEST=f60dc268b54ecf87f6e09d740c2b732838aa9193090cc741417c9f6386a130df
GRAFANA_TAG=13.3.0
GRAFANA_DIGEST=488984b716c0862639f91a698adbe2862677a5a07bad42da5f03f3030883b205
# NVIDIA's GPU exporter for the dashboard (nvcr.io; `pins check` does not
# resolve it, the tag pairs a DCGM version with the exporter's).
DCGM_EXPORTER_TAG=4.7.0-4.9.0
DCGM_EXPORTER_DIGEST=2490e1dfb5baaee6765ef2841813af7d978bb459a566c22c326a8fc27c64eea9
CUDA_MIN_DRIVER_MAJOR=580
