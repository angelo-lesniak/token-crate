# Local machine settings. This file is the reference for every setting;
# docs/configuration.md covers the storage layout, the pins, and upgrades.
#
# Run `bash bin/tokencrate init` to create a private .env from this file with
# mode 0600; copying it by hand may leave its permissions too broad.
# Values are literal: no variable or home-directory expansion.
# Write full paths and keep comments on their own lines.

# Host paths. Relative paths are resolved from the repository root.
LLM_MODELS_DIR=./data/models
LLM_AGENTS_DIR=./data/agents
LLM_SKILLS_DIR=./data/skills
# Private skills are mounted read-only into every agent container.
LLM_LOCAL_SKILLS_DIR=./local/skills

# Optional Hugging Face token for gated model sets. Accept the model license
# first. The wrapper reads this value in-process, removes it from the
# environment of every subprocess, and sends it to huggingface.co only; the
# agents' Hugging Face provider gets it only from the cloud keys file below.
# HF_TOKEN=hf_your_read_token

# Host ports, published on 127.0.0.1 only; no setting widens them.
# LLM_PORT serves the API and built-in chat UI. A browser UI publishes the
# host_port its set declares unless LLM_UI_PORT_<SET> names another (the
# set name in upper case, any other character as _); `ui <set> --port`
# overrides both for one launch. A custom UI set without host_port needs
# one of the two.
LLM_PORT=4207
# LLM_UI_PORT_PI_WEB=4224
# LLM_UI_PORT_PASEO=4250

# GPU selection.
GPU_DEVICE=nvidia.com/gpu=all
# false starts llama-server without a GPU device (CPU-only testing).
LLM_GPU=true

# The preset that llama-server loads at start and that agents use by default.
# List presets with: bash bin/tokencrate presets list
LLM_DEFAULT_PRESET=qwen3.8-27b-q4-mtp
# Comma-separated fetched skill sets loaded by agents.
# Fetch them with: bash bin/tokencrate skills fetch pocock-core skill-crate
# `agent` refuses to start until every named set is fetched. Leave empty
# to load no fetched sets. Private skills are always loaded.
# The full fetched-skills directory remains mounted read-only;
# docs/agents.md describes the skills view.
LLM_SKILL_SETS=pocock-core,skill-crate

# Comma-separated agent sets rendered into the pi image, from
# config/agent-sets and local/agent-sets.
# List them with: bash bin/tokencrate agent-sets list
# `agent pi --sets` overrides this for one session; empty selects plain pi.
LLM_AGENT_SETS=coding

# Cloud providers (optional): the file `agent pi --cloud` or `ui <set>
# --cloud` mounts into that one session or UI, one NAME=value line per
# key under pi's variable names;
# cloud-keys.env.example is the template. Keep it readable by your user
# only and outside every project and storage directory; docs/agents.md
# says what a session does with it.
LLM_CLOUD_KEYS_FILE=./local/cloud-keys.env

# Colon-separated extra directories below which `agent --dir` is allowed;
# every entry must be an absolute path. Projects below your home directory
# are always allowed.
LLM_PROJECT_ROOTS=
# Git identity for commits made inside agent containers.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com

# Runtime behavior.
# Size of the llama container's writable in-memory /tmp.
LLM_TMPFS_SIZE=2g
# Size of an agent container's writable in-memory /tmp (package caches).
LLM_AGENT_TMPFS_SIZE=1g
# Maximum number of processes inside the llama container.
LLM_PIDS_LIMIT=1024
# Compose restart policy. `no` avoids reserving the GPU after a reboot;
# use `unless-stopped` for automatic restart.
RESTART_POLICY=no
# Permission mask for files the containers create on the host mounts.
UMASK=0002

# Optional engine override. Detection selects Podman before Docker.
# CONTAINER_ENGINE=podman
# Prefix for container and network names.
COMPOSE_PROJECT_NAME=tokencrate
