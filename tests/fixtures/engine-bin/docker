#!/usr/bin/env python3
"""Fake container engine for the CLI tests. Answers the probes the wrapper
makes and records every `compose` invocation on stdout so tests can check the
routing; no container ever runs. Behaves as `podman` or `docker` from its
own file name. Controls (environment variables):
  FAKE_ENGINE_LLAMA_RUNNING=true    `ps` lists one running llama container
  FAKE_ENGINE_UI_SET=<set>          `ps` lists that set's UI pair (FAKE_ENGINE_UI_PORT its published port,
                                    FAKE_ENGINE_UI_EGRESS=1 the egress label on its UI container)
  FAKE_ENGINE_CONFIG_SHA256=<digest>  `inspect` reports this config label (default: rendered digest, or empty if absent)
  FAKE_ENGINE_STATE=<status>        `inspect` reports this .State.Status
  FAKE_ENGINE_NETWORK=<json>        `network inspect` prints this document (FAKE_ENGINE_NETWORK_<NAME> for one network)
  FAKE_PODMAN_COMPOSE_DOCKER_PLUGIN=true   `podman compose version` names the Docker plugin
  FAKE_PODMAN_ROOTLESS=false / FAKE_PODMAN_RUNTIME=runc   `podman info --format` values
"""

import hashlib
import json
import os
import shlex
import sys
from pathlib import Path

name = os.path.basename(sys.argv[0])
arguments = sys.argv[1:]
if "HF_TOKEN" in os.environ:
    print("fake engine: Hugging Face token leaked into the engine environment", file=sys.stderr)
    sys.exit(1)


def credentials():
    """Every non-empty credential-shaped variable in the engine environment,
    where none may be, and the host path of the keys file an `agent
    --cloud` run mounts with `run -v` (never read: only its path travels)."""
    names = sorted(key for key, value in os.environ.items() if key.endswith(("_API_KEY", "_TOKEN")) and value)
    mounted = ""
    for flag, value in zip(arguments, arguments[1:], strict=False):
        if flag == "-v" and value.endswith(":/etc/tokencrate/cloud-keys:ro"):
            mounted = value.split(":", 1)[0]
    return f"env_keys={','.join(names)} key_file={mounted}"


def trace(kind):
    print(
        f"{kind} project={os.environ.get('LLM_AGENT_PROJECT_DIR', 'unset')} "
        f"home={os.environ.get('TOKENCRATE_AGENT_HOME', 'unset')} "
        f"preset={os.environ.get('TOKENCRATE_PRESET', 'unset')} "
        f"sha={os.environ.get('TOKENCRATE_CONFIG_SHA256', 'unset')} "
        f"skill_sets={os.environ.get('LLM_SKILL_SETS', 'unset')} "
        f"{credentials()} args=" + " ".join(shlex.quote(item) for item in arguments)
    )


first = arguments[0] if arguments else ""
if first == "--version":
    print(f"{name} version 6.1.0-fake" if name == "podman" else "Docker version fake")
elif first == "info":
    if "--format" in arguments:
        rootless = os.environ.get("FAKE_PODMAN_ROOTLESS", "true")
        runtime = os.environ.get("FAKE_PODMAN_RUNTIME", "crun")
        print(f"{rootless}/{runtime}")
    else:
        print(f"fake {name} engine")
elif first == "compose" and arguments[1:2] == ["version"]:
    if name == "podman":
        print("podman version 6.1.0-fake")
        if os.environ.get("FAKE_PODMAN_COMPOSE_DOCKER_PLUGIN") == "true":
            print("Docker Compose version v2.0.0-fake")
        else:
            print("podman-compose version 1.6.0-fake")
    else:
        print("Docker Compose version fake")
elif first == "compose":
    trace("compose")
elif first == "ps":
    service = next(
        (arg.split("=", 2)[-1] for arg in arguments if arg.startswith("label=com.docker.compose.service=")), ""
    )
    if os.environ.get("FAKE_ENGINE_LLAMA_RUNNING") == "true" and service in ("", "llama"):
        print("fake-llama-container")
    ui = os.environ.get("FAKE_ENGINE_UI_SET", "")
    if ui:
        # The wrapper's fixed container names for the set's UI and forwarder.
        for role, name in (("agent-ui", f"tokencrate-ui-{ui}"), ("ui-forward", f"tokencrate-ui-forward-{ui}")):
            if service in ("", role):
                print(name)
elif first == "inspect":
    if arguments[2] == "{{json .}}":
        cid = arguments[-1]
        if cid == "fake-llama-container":
            service = "llama"
        elif cid.startswith("tokencrate-ui-forward-"):
            service = "ui-forward"
        else:
            service = "agent-ui"
        labels = {
            "com.docker.compose.project": os.environ.get("COMPOSE_PROJECT_NAME", "tokencrate"),
            "com.docker.compose.service": service,
        }
        if service != "llama":
            labels["io.tokencrate.ui-set"] = os.environ.get("FAKE_ENGINE_UI_SET", "")
            if service == "agent-ui" and os.environ.get("FAKE_ENGINE_UI_EGRESS"):
                labels["io.tokencrate.ui-egress"] = "1"
        port = (
            os.environ.get("FAKE_ENGINE_LLAMA_PORT", os.environ.get("LLM_PORT", "4207"))
            if service == "llama"
            else os.environ.get("FAKE_ENGINE_UI_PORT", "4224")
        )
        print(
            json.dumps(
                {
                    "Id": cid,
                    "Name": f"/{cid}",
                    "Config": {"Labels": labels, "Env": ["TOKENCRATE_UI_PORT=8504"] if service == "agent-ui" else []},
                    "NetworkSettings": {
                        "Ports": {
                            "8080/tcp": [{"HostIp": "127.0.0.1", "HostPort": port}]
                            if service in ("llama", "ui-forward")
                            else []
                        }
                    },
                }
            )
        )
    elif "io.tokencrate.config-sha256" in arguments[2]:
        # The CLI runs from the scratch checkout; the fixture engine lives
        # in the source checkout and can also be invoked from a project dir.
        digest = os.environ.get("FAKE_ENGINE_CONFIG_SHA256")
        if digest is None:
            config = Path(os.environ["PYTHONPATH"]) / "build/models.ini"
            try:
                digest = hashlib.sha256(config.read_bytes()).hexdigest()
            except FileNotFoundError:
                digest = ""
        print(digest)
    else:
        print(os.environ.get("FAKE_ENGINE_STATE", "running"))
elif arguments == ["version", "--format", "{{.Server.Version}}"]:
    print("29.7.2-fake")
elif arguments[:2] == ["network", "ls"]:
    pass
elif arguments[:2] == ["network", "inspect"]:
    # One object per invocation, as `--format '{{json .}}'` prints it: Docker's
    # shape without a gateway (isolated mode), Podman's with one.
    # FAKE_ENGINE_NETWORK=missing: the engine does not know the network.
    network = arguments[-1].rsplit("_", 1)[-1].upper().replace("-", "_")
    project = os.environ.get("COMPOSE_PROJECT_NAME", "tokencrate")
    default = (
        f'{{"subnets": [{{"subnet": "10.89.0.0/24", "gateway": "10.89.0.1"}}], "internal": true, '
        f'"labels": {{"com.docker.compose.project": "{project}"}}}}'
        if name == "podman"
        else f'{{"IPAM": {{"Config": [{{"Subnet": "172.18.0.0/16"}}]}}, "Internal": true, '
        f'"Labels": {{"com.docker.compose.project": "{project}"}}}}'
    )
    document = os.environ.get(f"FAKE_ENGINE_NETWORK_{network}", os.environ.get("FAKE_ENGINE_NETWORK", default))
    if document == "missing":
        print("Error: No such network", file=sys.stderr)
        sys.exit(1)
    print(document)
elif first in ("image", "build", "run", "exec", "stop", "rm", "logs"):
    trace(first)
else:
    print(f"fake engine: unsupported invocation: {' '.join(arguments)}", file=sys.stderr)
    sys.exit(1)
