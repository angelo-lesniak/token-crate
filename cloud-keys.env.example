# Template for the cloud keys file that `agent pi --cloud` or `ui <set>
# --cloud` mounts (LLM_CLOUD_KEYS_FILE, default local/cloud-keys.env).
# Copy it there and fill in the keys you use:
#   cp cloud-keys.env.example local/cloud-keys.env
#   chmod 600 local/cloud-keys.env
# docs/agents.md#cloud-providers has the grammar, the refused names, and what
# a --cloud session exposes.
#
# The variables pi 0.85.1 (PI_VERSION in pins.env) reads for the providers
# that take one key; pi's documentation lists every provider, including the
# ones that take two variables:
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# BASETEN_API_KEY=
# CEREBRAS_API_KEY=
# COPILOT_GITHUB_TOKEN=
# DEEPSEEK_API_KEY=
# FIREWORKS_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# XIAOMI_API_KEY=
# ZAI_API_KEY=
# HF_TOKEN=   (pi's Hugging Face provider; the downloader's token stays in .env)
