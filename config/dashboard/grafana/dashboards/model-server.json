{
  "uid": "tokencrate-model-server",
  "title": "TokenCrate model server",
  "tags": [
    "tokencrate"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests processing and queued",
      "description": "The router's request gauges for the loaded preset.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing",
          "legendFormat": "processing {{preset}}"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred",
          "legendFormat": "queued {{preset}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens per second",
      "description": "Rates of the server's counters, which llama.cpp advances when a request completes.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_total[1m])",
          "legendFormat": "prompt {{preset}}"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:tokens_predicted_total[1m])",
          "legendFormat": "generated {{preset}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Draft acceptance (MTP presets)",
      "description": "Accepted over drafted tokens, five-minute rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:spec_decode_num_accepted_tokens_total[5m]) / rate(llamacpp:spec_decode_num_draft_tokens_total[5m])",
          "legendFormat": "{{preset}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Busy slots per decode",
      "description": "How many of the preset's parallel slots one decode step served.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:n_busy_slots_per_decode",
          "legendFormat": "{{preset}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Loaded preset and exporter",
      "description": "1 while the named preset was loaded on two consecutive polls; the exporter scrapes only then.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (preset) (tokencrate_preset_loaded{preset!=\"\"})",
          "legendFormat": "{{preset}} loaded"
        },
        {
          "refId": "B",
          "expr": "tokencrate_router_up",
          "legendFormat": "router up"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU utilization and memory (LLM_GPU=true)",
      "description": "From dcgm-exporter, only with the dashboard-gpu profile; a CPU host shows no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "utilization %"
        },
        {
          "refId": "B",
          "expr": "DCGM_FI_DEV_FB_USED / 1024",
          "legendFormat": "memory used GiB"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU power and temperature",
      "description": "From dcgm-exporter, only with the dashboard-gpu profile.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokencrate-victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "power W"
        },
        {
          "refId": "B",
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "temperature C"
        }
      ]
    }
  ]
}
