<?xml version="1.0" encoding="utf-8"?>
<!-- Seeded into the agent home: the container has no route to nuget.org, so
     restore resolves from the packages the image cached at build time and
     fails fast on anything else instead of waiting for a timeout. -->
<configuration>
  <packageSources>
    <clear />
    <add key="tokencrate-image" value="/opt/nuget/packages" />
  </packageSources>
</configuration>
