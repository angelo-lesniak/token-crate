#!/usr/bin/env bash
# Starts PI WEB inside the pi container: the session daemon, then the web
# server, on the port the set declares. The wrapper's entrypoint has
# prepared the agent home and changed into the project directory.
set -Eeuo pipefail

# The port the set manifest declares, passed in by the wrapper, which
# hands the same value to the forwarder; declaring it twice would let the
# two drift, and a mismatch shows only as the `ui` start timeout.
readonly PORT=${TOKENCRATE_UI_PORT:?the wrapper sets this from the set manifest}
readonly DATA_DIR="$HOME/.pi-web"
readonly SOCKET=/run/tokencrate/pi-web-sessiond.sock

export PI_WEB_PORT=$PORT PI_WEB_DATA_DIR=$DATA_DIR PI_WEB_SESSIOND_SOCKET=$SOCKET
# No release check and no model-catalog refresh: the container has no
# route out unless the UI was started with --egress or --cloud, and the
# failures would only fill the log.
export PI_WEB_OFFLINE=1 PI_WEB_SKIP_VERSION_CHECK=1
# Keep the model's tool vocabulary the same as in the terminal: no
# PI WEB session-spawning tools (the coding set has a subagent tool) and
# no PI WEB environment facts in the system prompt.
export PI_WEB_SPAWN_SESSIONS=false PI_WEB_SUBSESSIONS=false PI_WEB_ENVIRONMENT_FACTS=false
# The address the daemon listens on: the container's address on the UI
# network, where the forwarder reaches it by name. A UI started with
# --egress or --cloud has a second interface, on the default network,
# which carries the default route; a daemon on every interface would
# answer there too, past the forwarder's Host check (the host on Docker,
# egress sessions on both engines). The image has no `ip`, so node reads
# the route table and the interfaces.
ui_address() {
  node -e '
    const routes = require("fs").readFileSync("/proc/net/route", "utf8").trim().split("\n").slice(1);
    const egress = new Set(routes.map((line) => line.trim().split(/\s+/)).filter((fields) => fields[1] === "00000000").map((fields) => fields[0]));
    const interfaces = Object.entries(require("os").networkInterfaces())
      .map(([name, entries]) => [name, entries.filter((entry) => entry.family === "IPv4" && !entry.internal).map((entry) => entry.address)])
      .filter(([, addresses]) => addresses.length > 0);
    // No network at all (network_mode none): loopback is the only place
    // to listen. One interface: the UI network, whatever its routes. More:
    // the UI network is the one without the default route.
    const candidates = interfaces.length <= 1 ? interfaces : interfaces.filter(([name]) => !egress.has(name));
    const addresses = candidates.flatMap(([, entries]) => entries);
    if (interfaces.length === 0) {
      console.log("127.0.0.1");
    } else if (addresses.length === 1) {
      console.log(addresses[0]);
    } else {
      console.error("TokenCrate UI: expected one interface without a default route, found " + addresses.length);
      process.exit(1);
    }
  '
}

mkdir -p "$DATA_DIR"
# The project directory is the only project; PI WEB lists it at once. The
# bundled relay package is recorded as dismissed so the daemon does not
# add it to pi's package list at every start (the entrypoint would remove
# it again).
node - "$DATA_DIR" "$PWD" "$HOME/.pi/agent" <<'JS'
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const [dataDir, project, profileDir] = process.argv.slice(2);
const now = new Date().toISOString();
const projectsFile = path.join(dataDir, "projects.json");
const dismissalsFile = path.join(dataDir, "pi-package-dismissals.json");
for (const file of [projectsFile, dismissalsFile]) {
  const stat = fs.lstatSync(file, { throwIfNoEntry: false });
  if (stat && !stat.isFile()) throw new Error(`TokenCrate UI: ${file} must be a regular file; move it aside`);
}
const read = (file, fallback) => {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch (error) { return fallback; }
};
const write = (file, value) => {
  const temporary = `${file}.${crypto.randomUUID()}.tmp`;
  try {
    fs.writeFileSync(temporary, JSON.stringify(value, null, 2) + "\n", { flag: "wx", mode: 0o600 });
    fs.renameSync(temporary, file);
  } finally { fs.rmSync(temporary, { force: true }); }
};
const projects = read(projectsFile, { projects: [] });
if (!Array.isArray(projects.projects)) projects.projects = [];
if (!projects.projects.some((entry) => entry && entry.path === project)) {
  projects.projects.push({ id: crypto.randomUUID(), name: path.basename(project), path: project, createdAt: now });
  write(projectsFile, projects);
}
const dismissals = read(dismissalsFile, { dismissals: [] });
if (!Array.isArray(dismissals.dismissals)) dismissals.dismissals = [];
if (!dismissals.dismissals.some((entry) => entry && entry.packageId === "@jmfederico/pi-relay" && entry.profileDir === profileDir)) {
  dismissals.dismissals.push({ profileDir, packageId: "@jmfederico/pi-relay", dismissedAt: now });
  write(dismissalsFile, dismissals);
}
JS

rm -f "$SOCKET"
address=$(ui_address)
export PI_WEB_HOST=$address
pi-web-sessiond &
sessiond=$!
ready=false
for _ in $(seq 1 60); do
  [[ -S "$SOCKET" ]] && { ready=true; break; }
  kill -0 "$sessiond" 2>/dev/null || { wait "$sessiond" || true; echo "TokenCrate UI: pi-web-sessiond exited before it listened" >&2; exit 1; }
  sleep 0.5
done
# Falling through silently turned a daemon that never listens into the
# wrapper's start timeout instead of a message from the launcher.
if [[ "$ready" != true ]]; then
  echo "TokenCrate UI: pi-web-sessiond did not create $SOCKET within 30 seconds" >&2
  kill "$sessiond" 2>/dev/null || true
  exit 1
fi
pi-web-server &
server=$!
trap 'kill "$sessiond" "$server" 2>/dev/null || true' EXIT
# Bash runs no EXIT trap for an untrapped fatal signal, so a container stop
# would leave both processes to the engine's kill; Paseo traps TERM too.
trap 'exit 143' TERM INT
echo "TokenCrate UI: PI WEB listens on $address:$PORT inside the container"
# The first process to exit ends the session; the trap stops the other.
wait -n "$sessiond" "$server"
