#!/usr/bin/env bash
# Starts pi-web (agegr/pi-web) inside the pi container on the port the set
# declares: one Next.js server that runs every session in its own process
# through pi's SDK, with the agent home the entrypoint prepared, in the
# project directory the entrypoint changed into.
set -Eeuo pipefail

# The port the set manifest declares, passed in by the wrapper, which
# hands the same value to the forwarder; declaring it twice would let the
# two drift, and a mismatch shows only as the `ui` start timeout.
readonly PORT=${TOKENCRATE_UI_PORT:?the wrapper sets this from the set manifest}
# TOKENCRATE_PREFIX puts the fixed container paths below a temporary root
# for the launcher test of the static gate; it is empty in the container.
readonly PREFIX=${TOKENCRATE_PREFIX:-}
readonly PACKAGE="$PREFIX/opt/tokencrate/sets/pi-web/node_modules/@agegr/pi-web"
# The package's `.next` links here (the set's build line).
readonly NEXT_DIR="$PREFIX/run/tokencrate/pi-web-next"
# pi-web keeps the sidebar (pins, archive, project order and names, read
# times) in this file beside pi's own files in the agent home, which is a
# tmpfs; the retained copy is in the set's state directory.
readonly STATE_NAME=pi-web-session-state.json
readonly LIVE_STATE="$HOME/.pi/agent/$STATE_NAME"
readonly RETAINED_STATE="$HOME/.pi-web/$STATE_NAME"
readonly SAVE_INTERVAL=5

# The address the server listens on: the container's address on the UI
# network, where the forwarder reaches it by name. A UI started with
# --egress or --cloud has a second interface, on the default network,
# which carries the default route; a server on every interface would
# answer there too, past the forwarder's Host check (the host on Docker,
# egress sessions on both engines). The image has no `ip`, so node reads
# the route table and the interfaces.
ui_address() {
  node -e '
    const routes = require("fs").readFileSync("/proc/net/route", "utf8").trim().split("\n").slice(1);
    const egress = new Set(routes.map((line) => line.trim().split(/\s+/)).filter((fields) => fields[1] === "00000000").map((fields) => fields[0]));
    const interfaces = Object.entries(require("os").networkInterfaces())
      .map(([name, entries]) => [name, entries.filter((entry) => entry.family === "IPv4" && !entry.internal).map((entry) => entry.address)])
      .filter(([, addresses]) => addresses.length > 0);
    // No network at all (network_mode none): loopback is the only place
    // to listen. One interface: the UI network, whatever its routes. More:
    // the UI network is the one without the default route.
    const candidates = interfaces.length <= 1 ? interfaces : interfaces.filter(([name]) => !egress.has(name));
    const addresses = candidates.flatMap(([, entries]) => entries);
    if (interfaces.length === 0) {
      console.log("127.0.0.1");
    } else if (addresses.length === 1) {
      console.log(addresses[0]);
    } else {
      console.error("TokenCrate UI: expected one interface without a default route, found " + addresses.length);
      process.exit(1);
    }
  '
}

# A regular file or nothing: the retained directory is the host's.
regular_or_absent() {
  if [[ -L "$1" || ( -e "$1" && ! -f "$1" ) ]]; then
    echo "TokenCrate UI: $1 must be a regular file; move it aside" >&2
    exit 1
  fi
}

# Copies one file into the retained directory by a rename, so a reader
# never sees half of it. The host owns that directory: a link or a
# directory planted at either name fails the copy instead of redirecting it.
retain() {
  rm -f "$2.tmp" 2>/dev/null || true
  cp -T --no-dereference --remove-destination "$1" "$2.tmp" && mv -T "$2.tmp" "$2"
}

# pi-web replaces the file by a rename, so a copy that differs is the
# whole of a later version. A file it could not parse it sets aside as
# <name>.corrupt-<time> and starts over; the set-aside copy is retained
# before the fresh state replaces the saved one. A failed save is reported
# and retried; it does not stop the UI.
save_state() {
  local file
  for file in "$LIVE_STATE".corrupt-*; do
    [[ -f "$file" && ! -L "$file" && ! -e "${RETAINED_STATE%/*}/${file##*/}" ]] || continue
    retain "$file" "${RETAINED_STATE%/*}/${file##*/}" || echo "TokenCrate UI: could not keep $file" >&2
  done
  [[ -f "$LIVE_STATE" && ! -L "$LIVE_STATE" ]] && ! cmp -s "$LIVE_STATE" "$RETAINED_STATE" || return 0
  retain "$LIVE_STATE" "$RETAINED_STATE" || echo "TokenCrate UI: could not save $RETAINED_STATE" >&2
}

# The build output, assembled in the run directory from links to the files
# the image ships, with fresh preview-mode secrets in the two files that
# hold them. Next.js skips pi-web's Host and Origin checks for a request
# that carries the published preview id, and pi-web replaces it only in
# the prerender manifest, while Next.js reads it from server/preview-props.json.
link_entries() {
  local entry
  shopt -s nullglob dotglob
  for entry in "$1"/*; do
    [[ "${entry##*/}" == "$3" ]] || ln -s "$entry" "$2/"
  done
  shopt -u nullglob dotglob
}
rm -rf "$NEXT_DIR"
mkdir -p "$NEXT_DIR/server"
link_entries "$PACKAGE/.next-image" "$NEXT_DIR" server
link_entries "$PACKAGE/.next-image/server" "$NEXT_DIR/server" preview-props.json
rm "$NEXT_DIR/prerender-manifest.json"
node - "$PACKAGE/.next-image" "$NEXT_DIR" <<'JS'
const fs = require("fs");
const crypto = require("crypto");
const [image, live] = process.argv.slice(2);
// The lengths Next.js generates at build time.
const preview = {
  previewModeId: crypto.randomBytes(16).toString("hex"),
  previewModeSigningKey: crypto.randomBytes(32).toString("hex"),
  previewModeEncryptionKey: crypto.randomBytes(32).toString("hex"),
};
const manifest = JSON.parse(fs.readFileSync(`${image}/prerender-manifest.json`, "utf8"));
manifest.preview = { ...manifest.preview, ...preview };
fs.writeFileSync(`${live}/prerender-manifest.json`, JSON.stringify(manifest));
const props = JSON.parse(fs.readFileSync(`${image}/server/preview-props.json`, "utf8"));
fs.writeFileSync(`${live}/server/preview-props.json`, JSON.stringify({ ...props, ...preview }));
JS

regular_or_absent "$RETAINED_STATE"
regular_or_absent "$RETAINED_STATE.tmp"
rm -f "$RETAINED_STATE.tmp"
[[ ! -f "$RETAINED_STATE" ]] || cp "$RETAINED_STATE" "$LIVE_STATE"

address=$(ui_address)
pi-web --hostname "$address" --port "$PORT" --no-open &
server=$!
( while sleep "$SAVE_INTERVAL"; do save_state; done ) &
saver=$!
# The server gets the container's stop signal and its grace period; the
# last state is saved after it has exited.
trap 'kill "$saver" 2>/dev/null || true; kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true; save_state' EXIT
# Bash runs no EXIT trap for an untrapped fatal signal, so a container stop
# would leave the server to the engine's kill.
trap 'exit 143' TERM INT
echo "TokenCrate UI: pi-web listens on $address:$PORT inside the container"
# The first process to exit ends the session; the trap stops the other.
wait -n "$server" "$saver"
